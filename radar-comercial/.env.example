# Copie este arquivo para .env.local (desenvolvimento) e cadastre os mesmos nomes
# em Vercel → Settings → Environment Variables (produção).

# --- Acesso ao painel ---
APP_PASSWORD=escolha-uma-senha-forte
AUTH_SECRET=uma-string-aleatoria-longa-so-para-assinar-o-cookie

# --- Cron / worker (a Vercel envia isso automaticamente para o cron em produção;
# defina um valor você mesmo para rodar localmente ou chamar o worker manualmente) ---
CRON_SECRET=uma-string-aleatoria-diferente

# --- Supabase (Settings → API no projeto Supabase) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude / Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Opcional: modelo usado na pesquisa e na redação dos e-mails
# CLAUDE_MODEL_RESEARCH=claude-sonnet-5
# CLAUDE_MODEL_WRITING=claude-sonnet-5

# --- Domínio de produção (essencial: a pesquisa encadeia uma cidade por vez
# chamando o próprio app; se apontar para um preview protegido, a cadeia para) ---
APP_URL=http://localhost:3000

# --- Parâmetros do agente (todos opcionais, valores padrão entre parênteses) ---
# MAX_SEARCHES_PER_CITY=12
# RESEARCH_CONCURRENCY=2
# MIN_MARGIN_BUSINESS_DAYS=3
# EMAIL_COOLDOWN_DAYS=10
# MAX_EMAILS_PER_DAY=20

# --- Descoberta automática de cidades (a IA escolhe sozinha novos municípios
# de SC/PR/RS a cada rodada do cron, respeitando estes tetos) ---
# MAX_ACTIVE_CITIES=30
# MAX_NEW_CITIES_PER_DAY=2

# --- Relatório diário por e-mail (opcional) ---
# REPORT_EMAIL=voce@suaempresa.com.br

# --- SMTP para envio dos e-mails (obrigatório para o botão "Enviar e-mail" funcionar) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM_NAME=Jonathan
# SMTP_BCC=
